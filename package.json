{
  "name": "roadmapper",
  "version": "0.1.0",
  "description": "Derive a Notion roadmap from GitLab epics and milestones. One way: GitLab stays the source of truth, Notion is the view.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "roadmapper": "./dist/src/main.js"
  },
  "main": "./dist/src/main.js",
  "files": [
    "dist/src/",
    "roadmapper.example.toml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/src/main.js",
    "watch": "tsc --watch",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:only": "node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "check:boundaries": "./scripts/check-boundaries.sh src/core && ./scripts/check-boundaries.sh src/source/gitlab && ./scripts/check-boundaries.sh src/output/notion"
  },
  "keywords": [
    "gitlab",
    "notion",
    "roadmap",
    "epics",
    "milestones"
  ],
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
